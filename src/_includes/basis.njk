<!DOCTYPE html>
<html lang="nl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ titel or site.naam }}</title>
<meta name="description" content="{{ omschrijving or site.footer_tekst }}">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&family=Sora:wght@700;800&display=swap">
<link rel="stylesheet" href="/css/stijl.css">
<link rel="icon" href="/img/favicon.ico" sizes="any">
<link rel="icon" type="image/png" sizes="32x32" href="/img/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/img/favicon-16x16.png">
<link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
<meta name="theme-color" content="#F7931E">
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.naam }}">
<meta property="og:locale" content="nl_NL">
<meta property="og:title" content="{{ titel or site.naam }}">
<meta property="og:description" content="{{ omschrijving or site.footer_tekst }}">
<meta property="og:url" content="{{ site.domein }}{{ page.url }}">
<meta property="og:image" content="{{ site.domein }}/img/deelplaatje.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Scale-up Leadership, we stappen in en pakken samen door">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ titel or site.naam }}">
<meta name="twitter:description" content="{{ omschrijving or site.footer_tekst }}">
<meta name="twitter:image" content="{{ site.domein }}/img/deelplaatje.png">
<link rel="canonical" href="{{ site.domein }}{{ page.url }}">
</head>
<body>

<nav>
  <div class="logo-row">
    <a href="/"><img src="/img/logo.png" alt="{{ site.naam }}" style="height: 74px; width: auto;"></a>
  </div>
  <button class="nav-toggle" aria-label="Menu" onclick="this.closest('nav').classList.toggle('open')">&#9776;</button>
  <div class="nav-links" onclick="this.closest('nav').classList.remove('open')">
    {%- for item in site.menu %}
    <a href="{{ item.url }}"{% if page.url == item.url %} class="active"{% endif %}{% if item.url == site.scan_url %} target="_blank" rel="noopener"{% endif %}>{{ item.label }}</a>
    {%- endfor %}
  </div>
  <a class="pill-btn" href="{{ site.scan_url }}" target="_blank" rel="noopener">{{ site.scan_knop }} <span class="arrow">&rarr;</span></a>
</nav>

<div class="page">
{{ content | safe }}

{%- if slot_cta != false and scanblok != false %}
<section class="slot-cta">
  <p>{{ site.slot_cta.tekst }}</p>
  <a class="pill-btn" href="{{ site.scan_url }}" target="_blank" rel="noopener">{{ site.slot_cta.knop }} <span class="arrow">&rarr;</span></a>
</section>
{%- endif %}
</div>

<footer>
  <div class="footer-top">
    <div>
      <h5>{{ site.naam }}</h5>
      <p style="font-size:13.5px; line-height:1.7; opacity:0.75;">{{ site.footer_tekst }}</p>
    </div>
    <div>
      <h5>Menu</h5>
      {%- for item in site.menu %}
      <a href="{{ item.url }}"{% if item.url == site.scan_url %} target="_blank" rel="noopener"{% endif %}>{{ item.label }}</a>
      {%- endfor %}
    </div>
    <div>
      <h5>Volg ons</h5>
      <a href="{{ site.linkedin }}" target="_blank" rel="noopener">LinkedIn</a>
    </div>
    <div>
      <h5>Contact</h5>
      <a href="mailto:{{ site.email }}">{{ site.email }}</a>
      <a href="/contact/">Plan een gesprek</a>
    </div>
  </div>
  <div class="footer-bottom">
    <span>&copy; {{ jaar }} {{ site.naam }}. Alle rechten voorbehouden.</span>
    {%- if site.footer_links %}
    <span class="footer-links">
      {%- for l in site.footer_links %}
      <a href="{{ l.url }}"{% if l.nieuw_tabblad %} target="_blank" rel="noopener"{% endif %}>{{ l.label }}</a>
      {%- endfor %}
      {%- if site.ga_id %}<a href="#" onclick="return cookiesOpnieuw(event)">Cookies</a>{% endif %}
    </span>
    {%- elif site.ga_id %}
    <span class="footer-links"><a href="#" onclick="return cookiesOpnieuw(event)">Cookies</a></span>
    {%- endif %}
    {%- if site.footer_slogan %}<span>{{ site.footer_slogan }}</span>{% endif %}
  </div>
</footer>

{% include "beweging.njk" %}
{% include "statistieken.njk" %}

</body>
</html>
