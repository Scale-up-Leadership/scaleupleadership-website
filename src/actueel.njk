---
layout: basis.njk
permalink: /actueel/
eleventyComputed:
  titel: "{{ pagina.actueel.titel }}"
  omschrijving: "{{ pagina.actueel.omschrijving }}"
---
{% set p = pagina.actueel %}

<section class="page-hero">
  <div class="page-hero-text">
    <div class="label">{{ p.hero.label }}</div>
    <h1 class="slab-hero">{{ p.hero.kop | safe }}{% if p.hero.kop_accent %}{% if p.hero.kop_accent[0] not in "?!.,:;" %} {% endif %}<span class="q">{{ p.hero.kop_accent }}</span>{% endif %}</h1>
    <hr class="rule">
    <p>{{ p.hero.tekst | safe }}</p>
  </div>
  <div class="merk-ring"></div><div class="merk-stip"></div>
</section>

<section class="insights">
  <div class="insights-grid">
    {%- for item in collections.actueel %}
    <a class="insight-card" href="{{ item.url }}">
      <div class="insight-img"{% if item.data.afbeelding %} style="background-image:url({{ item.data.afbeelding }}); background-size:cover; background-position:center;"{% endif %}></div>
      <div class="insight-body">
        <div class="insight-tag">{{ item.data.soort }}{% if item.data.auteur %} &middot; {{ item.data.auteur }}{% endif %}</div>
        <h4>{{ item.data.titel }}</h4>
        <div class="date">{{ item.data.datum | datum }}</div>
      </div>
    </a>
    {%- else %}
    <p>{{ p.leeg }}</p>
    {%- endfor %}
  </div>
</section>

{%- if p.podcast.tonen %}
<section class="podcast">
  <div class="podcast-inner">
    <div class="podcast-visual">
      <span class="podcast-icoon">&#127911;</span>
    </div>
    <div class="podcast-txt">
      <div class="artikel-meta"><span class="artikel-tag">Podcast</span> {{ p.podcast.meta }}</div>
      <h2 class="slab-heading">{{ p.podcast.kop }}</h2>
      <p class="lead">{{ p.podcast.lead }}</p>
      <p>{{ p.podcast.alinea1 }}</p>
      <p>{{ p.podcast.alinea2 }}</p>
      <p>{{ p.podcast.alinea3 }}</p>
      <p class="podcast-slot">{{ p.podcast.slot }}</p>
      <a class="pill-btn-outline" href="{{ p.podcast.knop_url }}">{{ p.podcast.knop }}</a>
    </div>
  </div>
</section>
{%- endif %}
