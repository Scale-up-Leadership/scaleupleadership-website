---
layout: basis.njk
permalink: /
slot_cta: false
eleventyComputed:
  titel: "{{ pagina.home.titel }}"
  omschrijving: "{{ pagina.home.omschrijving }}"
---
{% set p = pagina.home %}

<section class="hero{% if not p.hero.afbeelding %} hero-zonder-beeld{% endif %}">
  <div class="merk-ring"></div><div class="merk-stip"></div>
  <div class="hero-text">
    {%- set kopje = p.hero.label if p.hero.label is defined else "Fractional CxO voor de volgende fase van je bedrijf" %}
    {%- if kopje %}<div class="hero-label">{{ kopje }}</div>{% endif %}
    <h1 class="slab-hero">{{ p.hero.kop | safe }}{% if p.hero.kop_accent %}{% if p.hero.kop_accent[0] not in "?!.,:;" %} {% endif %}<span class="q">{{ p.hero.kop_accent }}</span>{% endif %}</h1>
    <hr class="rule">
    <p>{{ p.hero.tekst | safe }}</p>
    <div class="hero-cta">
      <a class="pill-btn" href="{{ site.scan_url }}" target="_blank" rel="noopener">{{ p.hero.knop_primair }} <span class="arrow">&rarr;</span></a>
      <a class="pill-btn-outline" href="/contact/">{{ p.hero.knop_secundair }}</a>
    </div>
  </div>
  {%- if p.hero.afbeelding %}
  <div class="hero-photo-wrap">
    <div class="hero-photo{% if p.hero.vul_vlak %} hero-photo-vol{% endif %}" style="background-image:url('{{ p.hero.afbeelding }}')"></div>
  </div>
  {%- endif %}
</section>

<section class="journey">
  {%- for stap in p.reis %}
  {%- if loop.index > 1 %}<div class="journey-arrow">- - - &rarr;</div>{% endif %}
  <div class="journey-step">
    <div class="journey-icon">{{ loop.index }}</div>
    <div>
      <div class="journey-label">{{ stap.label }}</div>
      <div class="journey-desc">{{ stap.tekst }}</div>
    </div>
  </div>
  {%- endfor %}
</section>

<div class="trustbar">
  <div class="label">{{ p.trustbar.label }}</div>
  <div class="trust-logos">
    {%- if p.trustbar.logos and p.trustbar.logos.length %}
    {%- for l in p.trustbar.logos %}
    {%- if l.logo %}
    <span class="trust-logo beeld"><img src="{{ l.logo }}" alt="{{ l.naam }}" loading="lazy"></span>
    {%- else %}
    <span class="trust-logo">{{ l.naam }}</span>
    {%- endif %}
    {%- endfor %}
    {%- else %}
    {%- for naam in p.trustbar.namen %}
    <span class="trust-logo">{{ naam }}</span>
    {%- endfor %}
    {%- endif %}
  </div>
</div>

<section class="intro">
  <div class="label">{{ p.intro.label }}</div>
  <p>{{ p.intro.tekst | safe }}</p>
</section>

<section class="triggers">
  <div class="section-head">
    <div class="section-title slab-heading">{{ p.triggers.kop }}</div>
    <div class="section-sub">{{ p.triggers.sub }}</div>
  </div>
  <div class="trigger-row">
    {%- for k in p.triggers.kaarten %}
    <div class="trigger-card">
      <div class="dot-label"><span class="dot"></span>{{ k.kop }}</div>
      <p>{{ k.tekst }}</p>
    </div>
    {%- endfor %}
  </div>
</section>

<section class="diensten-lijst">
  <div class="section-head">
    <div class="section-title slab-heading">{{ p.diensten.kop }}</div>
    <div class="section-sub">{{ p.diensten.sub }}</div>
  </div>
  <div class="diensten-ul">
    <div class="diensten-row row-3">
      {%- for item in p.diensten.items %}{% if loop.index <= 3 %}
      <div class="dienst-item"><div class="bullet">{{ loop.index }}</div><h4>{{ item | safe }}</h4></div>
      {%- endif %}{% endfor %}
    </div>
    <div class="diensten-row row-4">
      {%- for item in p.diensten.items %}{% if loop.index > 3 %}
      <div class="dienst-item"><div class="bullet">{{ loop.index }}</div><h4>{{ item | safe }}</h4></div>
      {%- endif %}{% endfor %}
    </div>
  </div>
</section>

<section class="pakketten">
  <div class="pakketten-grid">
    {%- for k in p.pakketten.kaarten %}
    {#- Het anker komt uit de naam: "Scale-up Droom" wordt /aanpak/#droom.
        Wil je ergens anders heen, dan kan dat met een veld link op de kaart. #}
    {%- set anker = k.naam | lower | replace("scale-up ", "") | replace("het ", "") | trim %}
    <a class="pakket-card{% if k.uitgelicht %} highlight{% endif %}" href="{{ k.link or ('/aanpak/#' + anker) }}">
      {%- if k.badge %}<div class="pakket-badge">{{ k.badge }}</div>{% endif %}
      <div class="pakket-naam">{{ k.naam }}</div>
      <div class="pakket-prijs">{{ k.prijs }}</div>
      <div class="pakket-duur">{{ k.duur }}</div>
      <div class="pakket-desc">{{ k.tekst }}</div>
      <div class="pakket-meer">Bekijk de aanpak &rarr;</div>
    </a>
    {%- endfor %}
  </div>
</section>

<section class="testimonial">
  <span class="quote-mark">&rdquo;</span>
  <blockquote>{{ p.quote.tekst }}</blockquote>
  <cite>{{ p.quote.bron }}</cite>
</section>

<section class="team">
  <div class="section-head">
    <div class="section-title slab-heading">{{ p.team.kop }}</div>
    <div class="section-sub">{{ p.team.sub }}</div>
  </div>
  <div class="team-grid">
    {%- for lid in team.leden %}{% if lid.op_home %}
    <div class="team-card">
      <div class="team-photo{% if lid.foto %} heeft-foto{% endif %}"{% if lid.foto %} style="background-image:url('{{ lid.foto }}')"{% endif %}>{% if not lid.foto %}Foto{% endif %}</div>
      <h3>{{ lid.naam }}</h3>
      <div class="role">{{ lid.rol_kort }}</div>
      <p class="bio">{{ lid.bio }}</p>
      <a class="li-link" href="{{ lid.linkedin }}" target="_blank" rel="noopener">Bekijk LinkedIn &rarr;</a>
    </div>
    {%- endif %}{% endfor %}
    <a class="team-card team-meer" href="/over-ons/">
      <div class="team-photo meer">
        <div class="gezichten">
          <span class="gez g1"></span><span class="gez g2"></span><span class="gez g3"></span><span class="gez g4"></span>
          <span class="gez plus">+</span>
        </div>
        <div class="meer-plus">en de rest van het Scale-up Leadership team</div>
      </div>
      <h3>{{ p.team.meer_kop }}</h3>
      <div class="role">{{ p.team.meer_rol }}</div>
      <p class="bio">{{ p.team.meer_tekst }}</p>
      <span class="li-link">{{ p.team.meer_link | safe }}</span>
    </a>
  </div>
</section>

{%- set laatste = collections.actueel %}
{%- if laatste.length %}
<section class="insights">
  <div class="section-head">
    <div class="section-title slab-heading">{{ p.inzichten.kop }}</div>
    <div class="section-sub">{{ p.inzichten.sub }}</div>
  </div>
  <div class="insights-grid">
    {%- for item in laatste %}{% if loop.index <= 3 %}
    <a class="insight-card" href="{{ item.url }}">
      <div class="insight-img"{% if item.data.afbeelding %} style="background-image:url('{{ item.data.afbeelding }}'); background-size:cover; background-position:center;"{% endif %}></div>
      <div class="insight-body">
        <div class="kaart-meta">
          <span class="kaart-tag">{{ item.data.soort }}</span>
          {%- set bij = item.data.status or item.data.auteur %}
          {%- if bij %}<span class="kaart-sub">{{ bij }}</span>{% endif %}
        </div>
        <h4>{{ item.data.titel }}</h4>
        {%- if item.data.intro %}<p class="insight-intro">{{ item.data.intro }}</p>{% endif %}
        <div class="date">{{ item.data.datum | datum }}</div>
      </div>
    </a>
    {%- endif %}{% endfor %}
  </div>
</section>
{%- endif %}

<section class="functioneel">
  <h2 class="slab-heading">{{ p.scanblok.kop }}</h2>
  <p>{{ p.scanblok.tekst }}</p>
  <div class="functioneel-box">
    <div class="fring"></div>
    <div class="steps-row">
      {%- for stap in p.scanblok.stappen %}
      <div class="step"><div class="n">{{ loop.index }}</div><p>{{ stap }}</p></div>
      {%- endfor %}
    </div>
    <a class="pill-btn" href="{{ site.scan_url }}" target="_blank" rel="noopener">{{ site.scan_knop }} <span class="arrow">&rarr;</span></a>
  </div>
</section>
